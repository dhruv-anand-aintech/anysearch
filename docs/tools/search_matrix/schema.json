{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search_matrix/schema/provider",
  "type": "object",
  "required": [
    "name",
    "links",
    "env_keys",
    "python_extra",
    "requires_key",
    "snippet",
    "domains",
    "country",
    "language",
    "date",
    "safe_search",
    "mode",
    "pricing_per_1k",
    "free_tier_limits",
    "p50_latency",
    "answer",
    "content",
    "summary",
    "highlights",
    "news",
    "api_category",
    "api_status",
    "native_api",
    "sdk_support",
    "checked_at",
    "rate_limits",
    "capability_basis"
  ],
  "properties": {
    "name": {
      "type": "string",
      "$comment": "About | Name | Search API provider."
    },
    "links": {
      "allOf": [
        {
          "$ref": "#/$defs/links"
        }
      ],
      "$comment": "About | Links | Docs, site, and slug."
    },
    "env_keys": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "About | Env vars | API keys anysearch reads from the environment."
    },
    "python_extra": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "About | pip extra | Optional anysearch-sdk extra that installs the native SDK."
    },
    "requires_key": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "About | Credentials required | API keys or other API authentication required; none = keyless."
    },
    "snippet": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "Response | Snippet | Short result description; model-only abstractions are distinguished."
    },
    "domains": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "Request | Domain filters | include_domains / exclude_domains."
    },
    "country": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "Request | Country | ISO 3166-1 alpha-2 region bias."
    },
    "language": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "Request | Language | ISO 639-1 language filter."
    },
    "date": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "Request | Date range | start/end published date filters."
    },
    "safe_search": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "Request | Safe search | off / moderate / strict."
    },
    "mode": {
      "allOf": [
        {
          "$ref": "#/$defs/stringListWithSource"
        }
      ],
      "$comment": "Request | Mode | fast, balanced, and deep depth knobs supported via anysearch."
    },
    "pricing_per_1k": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "Request | Pricing / 1K | Approximate USD per 1,000 queries by anysearch mode."
    },
    "free_tier_limits": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "Request | Free tier limits | Standing free allowance, signup credit, or no-free-tier caveat."
    },
    "p50_latency": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "Performance | Latency by tier | Public p50/p90/p95, averages, or documented ranges with provenance."
    },
    "answer": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "Response | AI Answer | Top-level synthesized answer; hosted model generation is labeled separately."
    },
    "content": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "Response | Full text | Full linked-page content; model-only browsing and separate fetch endpoints are partial."
    },
    "summary": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "Response | Summary | Per-result page summary; generated-answer summaries are not equivalent."
    },
    "highlights": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "Response | Highlights | Query-relevant excerpts."
    },
    "news": {
      "allOf": [
        {
          "$ref": "#/$defs/featureWithSource"
        }
      ],
      "$comment": "Request | News | Dedicated news vertical or limited general-news access; see cell evidence."
    },
    "notes": {
      "type": "string",
      "$comment": "About | Notes | Caveats for this row."
    },
    "api_category": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "About | Product category | Standalone, third-party SERP, model grounding, or legacy."
    },
    "api_status": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "About | Availability | Current availability and retirement conditions."
    },
    "native_api": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "About | Native API overview | Official product features; separate from SDK mappings below."
    },
    "sdk_support": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "About | anysearch SDK | Whether a unified SDK adapter is available."
    },
    "checked_at": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "About | Evidence checked | Date of official documentation review, not a benchmark run."
    },
    "rate_limits": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "About | Limits / billing caveats | Units, plan limits and conditions are not interchangeable."
    },
    "comparison_only": {
      "type": "boolean"
    },
    "evidence": {
      "type": "object"
    },
    "capability_basis": {
      "allOf": [
        {
          "$ref": "#/$defs/stringWithSource"
        }
      ],
      "$comment": "About | Capability basis | Native provider documentation or existing SDK mapping; SDK availability is separate."
    }
  },
  "$defs": {
    "links": {
      "type": "object",
      "required": [
        "docs",
        "website",
        "slug"
      ],
      "properties": {
        "docs": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        }
      }
    },
    "featureWithSource": {
      "type": "object",
      "required": [
        "support",
        "source_url",
        "comment"
      ],
      "properties": {
        "support": {
          "enum": [
            "",
            "none",
            "partial",
            "full",
            "unknown",
            "not_applicable"
          ]
        },
        "source_url": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "checked_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "stringWithSource": {
      "type": "object",
      "required": [
        "value",
        "source_url",
        "comment"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "primary_price": {
          "type": "object",
          "required": [
            "amount_usd_per_1k",
            "billing_unit",
            "basis",
            "source_url",
            "checked_at"
          ],
          "properties": {
            "amount_usd_per_1k": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "billing_unit": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "checked_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "lowest_price": {
          "description": "Lowest documented per-1K price for the provider's own search product; null when no comparable hosted rate exists.",
          "type": "object",
          "required": [
            "amount_usd_per_1k",
            "billing_unit",
            "basis",
            "source_url",
            "checked_at"
          ],
          "properties": {
            "amount_usd_per_1k": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "billing_unit": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "checked_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    },
    "stringListWithSource": {
      "type": "object",
      "required": [
        "values",
        "source_url",
        "comment"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_url": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      }
    }
  }
}
